    {
      "start": 0,
      "end": 0,
      "members": [
        "ARNAU"
      ],
      "original": "Back in the town, 여기 드디어",
      "romanization": "back in the town, yeogi deudieo",
      "english": "Back in the town, Finally my feet",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "지면 위에 발을 딛어, 내 집이야",
      "romanization": "jimyeon wie bareul dideo, nae jibiya",
      "english": "Touch the ground, This is my home",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "내 말 끝나기 무섭게, 모두 Hit me up",
      "romanization": "nae mal kkeunnagi museopge, modu hit me up",
      "english": "Everyone hits me up, Before I can even finish talking",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "준비해 We gon' turn it up",
      "romanization": "junbihae we gon' turn it up",
      "english": "Get ready, we gon' turn it up",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "We’re so hot 가끔은 해가 숨어",
      "romanization": "we’re so hot gakkeumeun haega sumeo",
      "english": "We're so hot Sometimes the sun hides away",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "네가 알고 있던 화끈함은 잊어",
      "romanization": "nega algo itdeon hwakkeunhameun ijeo",
      "english": "Forget the heat you thought you knew",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "When I hit the stage, Yeah I’m back again, Say my name 더 크게",
      "romanization": "when i hit the stage, yeah i’m back again, say my name deo keuge",
      "english": "When I hit the stage, Yeah, I'm back again, Say my name, louder",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "주저하지 마 더 거침없이 Blow",
      "romanization": "jujeohaji ma deo geochim eopsi blow",
      "english": "Don't hesitate, blow it without holding back",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "어떤 순간도 We can’t go wrong",
      "romanization": "eotteon sungando we can’t go wrong",
      "english": "Whatever the moment, we can't go wrong",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "Ready to pop off!, 다 쏟아내 봐, 느낌은 완전 Jackpot",
