        ],
        [
          15.56,
          16.43
        ]
      ],
      "original": "ひと夏の愛 oh I, oh I, セツナハナビ stay",
      "romanization": "hito natsu no ai oh i, oh i, setsuna hanabi stay",
      "english": "A summer love oh I, oh I, A momentary firework, stay",
      "adlib": false
    },
    {
      "start": 33.64,
      "end": 36.84,
      "members": [
        "MARC"
      ],
      "voice": [
        [
          33.69,
          36.86
        ]
      ],
      "original": "茹だるような夏の暑さに",
      "romanization": "udaru you na natsu no atsusa ni",
      "english": "The scorching heat of the summer",
      "adlib": false
    },
    {
      "start": 37.69,
      "end": 40.95,
      "members": [
        "MARC"
      ],
      "voice": [
        [
          37.66,
          40.92
        ]
      ],
      "original": "この愛し方はよく似ている",
      "romanization": "kono aishikata wa yoku nite iru",
      "english": "It's just like the way we love each other",
      "adlib": false
    },
    {
      "start": 41.25,
      "end": 45.17,
      "members": [
        "IRENE"
      ],
      "voice": [
        [
          41.23,
          43.13
        ],
        [
          43.34,
          45.19
        ]
      ],
      "original": "破裂しそうな光を待って",
      "romanization": "haretsu shisou na hikari o matte",
      "english": "Waiting for a spark that might burst any moment",
      "adlib": false
    },
    {
      "start": 45.35,
      "end": 48.58,
