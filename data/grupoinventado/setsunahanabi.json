        "IRENE"
      ],
      "voice": [
        [
          45.35,
          47.22
        ],
        [
          47.37,
          48.62
        ]
      ],
      "original": "残された時間数えてる",
      "romanization": "nokosareta jikan kazoeteru",
      "english": "Counting the time we have left",
      "adlib": false
    },
    {
      "start": 48.88,
