    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "今日から共に歩んで欲しい",
      "romanization": "Kyou kara tomo ni ayunde hoshii",
      "english": "I want you to walk with me from today onwards"
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "ささやかな言葉を終え",
      "romanization": "Sasayakana kotoba wo oe",
      "english": "Give me a few words"
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "過ぎ去った季節に水をやり",
      "romanization": "Sugisatta kisetsu ni mizu wo yari",
      "english": "The best time to see the past season"
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "枯れない花となった",
