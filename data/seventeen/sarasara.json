      "english": "It has become a flower that does not wither"
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "出会いの若かった頃",
      "romanization": "Deai no wakakatta koro",
      "english": "In the early days of someone's encounter"
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
