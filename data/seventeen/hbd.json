    {
      "start": 0.62,
      "end": 3.99,
      "members": [
        "MINGYU"
      ],
      "original": "내일 없는 매일을 살고 있잖아",
      "romanization": "naeil eomneun maeireul salgo itjana",
      "english": "I'm living every day as if there were no tomorrow",
      "adlib": false
    },
    {
      "start": 4.11,
      "end": 7.63,
      "members": [
        "MINGYU"
      ],
      "original": "오늘 하룬 살고픈 대로 살 거야",
      "romanization": "oneul harun salgopeun daero sal geoya",
      "english": "Today, I'll live the day however I want",
      "adlib": false
    },
    {
      "start": 7.98,
      "end": 12.65,
      "members": [
        "MINGYU"
      ],
      "original": "촛불 켜고서 소원을 빌어 다 **이뤄질 거야@THE8**",
      "romanization": "chotbul kyeogeoseo sowoneul bireo **da irwojil geoya@THE8**",
      "english": "I'll light the candles and make a wish, **It'll all come true@THE8**",
      "adlib": false
    },
    {
      "start": 12.8,
      "end": 14.46,
      "members": [
        "S.COUPS"
      ],
      "original": "",
      "romanization": "Happy birthday to you",
      "english": "",
      "adlib": false
    },
    {
      "start": 14.61,
      "end": 17.81,
      "members": [
        "VERNON"
      ],
      "original": "마음처럼 되는 건 이 세상엔 없었어",
      "romanization": "maeumcheoreom doeneun geon i sesangen eopseosseo",
      "english": "Nothing in this world ever went the way I wanted",
      "adlib": false
    },
    {
      "start": 17.99,
      "end": 21.03,
      "members": [
        "VERNON"
      ],
      "original": "골치 아픈 얘긴 껌딱지 같잖아",
      "romanization": "golchi apeun yaegin kkeomttakji gatjana",
      "english": "Those troublesome stories are like gum stuck to me",
      "adlib": false
    },
    {
      "start": 21.51,
      "end": 24.37,
      "members": [
        "VERNON"
      ],
      "original": "힘내라는 말 위로 되지 않아 꺼져",
      "romanization": "himnaeraneun mal wiro doeji ana kkeojyeo",
      "english": "Telling me to cheer up doesn't comfort me",
      "adlib": false
    },
    {
      "start": 24.52,
      "end": 27.64,
      "members": [
        "VERNON"
      ],
      "original": "말 같잖은 소린 그만해 해 해",
      "romanization": "mal gatjanheun sorin geumanhae hae hae",
      "english": "So screw it, Stop saying things that don't even make sense, hey hey",
      "adlib": false
    },
    {
      "start": 27.76,
      "end": 31.25,
      "members": [
        "THE8"
      ],
      "original": "손가락질 진절머리 났어",
      "romanization": "songarakjil jinjeolmeori nasseo",
      "english": "I'm sick and tired of people pointing fingers",
      "adlib": false
    },
    {
      "start": 31.37,
      "end": 34.61,
      "members": [
        "THE8"
      ],
      "original": "맘 같아선 한 대 치고 싶어",
      "romanization": "mam gataseon han dae chigo sipeo",
      "english": "If I had it my way, I'd like to punch them once",
      "adlib": false
    },
    {
      "start": 34.79,
      "end": 38.01,
      "members": [
        "JOSHUA"
      ],
      "original": "그래도 난 다시 태어나도",
