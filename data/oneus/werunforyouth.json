  "lyrics": [
    {
      "start": 13.27,
      "end": 16.48,
      "members": [],
      "original": "기억은 마치 오랜 필름처럼",
      "romanization": "gieogeun machi oraen pilreomcheoreom",
      "english": "Memory is like an old film",
      "adlib": false,
      "voice": [
        [
          13.34,
          16.52
        ]
      ]
    },
    {
      "start": 16.91,
      "end": 20.29,
      "members": [],
      "voice": [
        [
          17,
          20.38
        ]
      ],
      "original": "빛에 바랠수록 흐려져 가",
      "romanization": "biche baraelsurok heuryeojyeo ga",
      "english": "The more it fades in the light the blurrier it becomes",
      "adlib": false
    },
    {
      "start": 20.9,
      "end": 26.87,
      "members": [],
      "voice": [
        [
          20.88,
          22.96
        ],
        [
          24.31,
          26.89
        ]
      ],
      "original": "우린 그 사이에 남겨진 장면처럼",
      "romanization": "urin geu saie namgyeojin jangmyeoncheoreom",
      "english": "Like a scene left behind between us",
      "adlib": false
    },
    {
      "start": 27.37,
      "end": 30.92,
      "members": [],
      "voice": [
        [
          27.36,
          30.9
        ]
      ],
      "original": "이름 없는 별들을 세어보다",
      "romanization": "ireum eomneun byeoldeureul seeoboda",
      "english": "As we count the nameless stars",
      "adlib": false
    },
    {
      "start": 31.07,
      "end": 34.85,
      "members": [],
      "voice": [
        [
          31.09,
          34.72
        ]
      ],
      "original": "서로의 눈 그 안의 우주",
      "romanization": "seoroui nun geu anui uju",
      "english": "Each other’s eyes and the universe within them",
      "adlib": false
    },
    {
      "start": 35.56,
      "end": 41.52,
      "members": [],
      "voice": [
        [
          35.5,
          37.03
        ],
        [
          38.13,
          41.53
        ]
      ],
      "original": "그 속에서 사라지지 않도록",
      "romanization": "geu sogeseo sarajiji antorok",
      "english": "So that we won’t disappear in that place",
      "adlib": false
    },
    {
      "start": 42.54,
      "end": 48.77,
      "members": [],
      "voice": [
        [
          42.54,
          45.16
        ],
        [
          45.37,
          48.78
        ]
      ],
      "original": "달아나는 시간은, 우리를 기다려 주지 않아",
      "romanization": "darananeun siganeun, urireul gidaryeo juji ana",
      "english": "Time that runs away, Won’t wait for us",
      "adlib": false
    },
    {
      "start": 49.18,
      "end": 55.35,
      "members": [],
      "voice": [
        [
          49.14,
          51.83
        ],
        [
          52.5,
          55.67
        ]
      ],
      "original": "어둠 속에서도 난, 이 손을 놓지 않아",
      "romanization": "eodum sogeseodo nan, i soneul nohji ana",
      "english": "Even in the darkness, I won’t let go of this hand",
      "adlib": false
    },
    {
      "start": 55.59,
      "end": 62.62,
      "members": [
        "LEEDO"
      ],
      "voice": [
        [
          55.72,
          58.78
        ],
        [
          58.99,
          62.65
        ]
      ],
      "original": "We run for youth, 다친 마음까지 끌어안을 테니",
      "romanization": "we run for youth, dachin maeumkkaji kkeureoaneul teni",
      "english": "We run for youth, Because I’ll embrace even your wounded heart",
      "adlib": false
    },
    {
      "start": 62.83,
      "end": 69.72,
      "members": [],
      "voice": [
        [
          62.81,
          65.87
        ],
        [
          66.09,
          69.75
        ]
      ],
      "original": "We run for youth, 불완전한 세계의 넌 눈부셔",
      "romanization": "we run for youth, bulwanjeonhan segyeui neon nunbusyeo",
      "english": "We run for youth, You are dazzling in this imperfect world",
      "adlib": false
    },
    {
      "start": 69.9,
      "end": 76.79,
      "members": [],
      "voice": [
        [
          69.75,
          72.93
        ],
        [
          73.14,
          76.74
        ]
      ],
      "original": "끝나지 않을 우리의 이야기에서 만나",
      "romanization": "kkeunnaji aneul uriui iyagieseo manna",
      "english": "We’ll meet in our story that will never end",
      "adlib": false
    },
    {
      "start": 77.15,
      "end": 83.37,
      "members": [],
      "voice": [
        [
          77.17,
          80.26
        ],
        [
          80.47,
          83.24
        ]
      ],
      "original": "언젠가 함께 꿈꿔왔던 그곳에서",
      "romanization": "eonjenga hamkke kkumkkwowatdeon geugoseseo",
      "english": "Someday in the place we once dreamed of together",
      "adlib": false
    },
    {
