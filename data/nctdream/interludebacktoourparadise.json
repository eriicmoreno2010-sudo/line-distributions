  "lyrics": [
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "내 작은 꿈 지나, 본 적 없던 그림",
      "romanization": "nae jageun kkum jina, bon jeok eopdeon geurim",
      "english": "Past my small dream, A picture I've never seen before",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "어디로 갈까, 두 손을 꼭 잡고서, 잠깐 눈을 감아",
      "romanization": "eodiro galkka, du soneul kkok japgoseo, jamkkan nuneul gama",
      "english": "Where should we go, Holding hands tightly, We close our eyes for a moment",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "(잠깐 눈을 감아)",
      "romanization": "(jamkkan nuneul gama)",
      "english": "(Close our eyes for a moment)",
      "adlib": true
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "잠시만 쉬어가 우리 여기, 비워 둔 이야기 사이",
      "romanization": "jamsiman swieoga uri yeogi, biwo dun iyagi sai",
      "english": "Let's take a short break right here, In the space between unfinished stories",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "설레는 마음까지",
      "romanization": "seolleneun maeumkkaji",
      "english": "Even the fluttering hearts",
      "adlib": false
