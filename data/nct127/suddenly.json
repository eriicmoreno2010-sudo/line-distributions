    {
      "start": 1.56,
      "end": 4.38,
      "members": [],
      "original": "예보 없이 만난 비처럼",
      "romanization": "yebo eopsi mannan bicheoreom",
      "english": "Like rain that comes without a forecast",
      "adlib": false
    },
    {
      "start": 4.65,
      "end": 8.65,
      "members": [],
      "original": "갑작스레 내게 쏟아져, 피할 틈도 없이",
      "romanization": "gapjagseure naege ssodajyeo, pihal teumdo eopsi",
      "english": "Suddenly pouring down on me, Without a chance to escape",
      "adlib": false
    },
    {
      "start": 8.77,
      "end": 12.39,
      "members": [],
      "original": "난 그저 너를 향해 가, 그 누구도 모르게",
