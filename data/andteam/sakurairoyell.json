  "lyrics": [
    {
      "start": 0,
      "end": 0,
      "members": [
        "K"
      ],
      "original": "やわらかな風が この世界ごと包み込んで",
      "romanization": "yawarakana kaze ga kono sekaigoto tsutsumikonde",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "僕らの背中を押すよ Oh",
      "romanization": "bokura no senaka o osu yo oh",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "期待と不安",
      "romanization": "kitai to fuan",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "入り混じった心がまたこそばゆくて",
      "romanization": "iri majitta kokoro ga mata kosobayukute",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "ほどけた蕾のよう",
      "romanization": "hodoketa tsubomi no yō",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "芽吹き始めた希望 夢",
      "romanization": "mebuki hajimeta kibō yume",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "心の奥で抱きしめ",
      "romanization": "kokoro no oku de dakishime",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "どんな夜も超えて 君と咲かせたい",
      "romanization": "donna yoru mo koete kimi to sakasetai",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "きっと 色褪せることはない",
      "romanization": "kitto iroaseru koto wa nai",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "桜色Yell 君に届け",
      "romanization": "sakura-iro yell kimi ni todoke",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "離れても 変わらずに 味方でいるから",
      "romanization": "hanarete mo kawarazu ni mikata de iru kara",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "何年後の 未来だって",
      "romanization": "nannen-go no mirai datte",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "また会える 約束をかわそう",
      "romanization": "mata aeru yakusoku o kawasō",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "鮮やかな花も せわしい日々を生きてると",
      "romanization": "azayaka na hana mo sewashii hibi o ikiteru to",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "モノクロに見えてしまうよ Oh",
      "romanization": "monokuro ni miete shimau yo oh",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "心配ない 迷った時にはいつも",
      "romanization": "shinpai nai mayotta toki ni wa itsumo",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "大切な記憶が 胸に光るよ",
      "romanization": "taisetsu na kioku ga mune ni hikaru yo",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "今思えばひとりよがりの日々も",
      "romanization": "ima omoeba hitoriyogari no hibi mo",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "振り向けば君が隣にいた",
      "romanization": "furimukeba kimi ga tonari ni ita",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "これからもずっと変わらずずっと",
      "romanization": "kore kara mo zutto kawarazu zutto",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "この場所で君を待ってる",
      "romanization": "kono basho de kimi o matteru",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "桜色Yell 君に届け",
      "romanization": "sakura-iro yell kimi ni todoke",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "誰よりも すぐそばに 感じられるから",
      "romanization": "dare yori mo sugu soba ni kanjirareru kara",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "何回でも 思い出して",
      "romanization": "nankai demo omoidashite",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "いつまでも 結ばれた 絆を",
      "romanization": "itsu made mo musubareta kizuna o",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "Always the only one",
      "romanization": "always the only one",
      "english": "",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "ヒラヒラと舞う花びら",
