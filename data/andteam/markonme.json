  "lyrics": [
    {
      "start": 0,
      "end": 0,
      "members": [
        "K"
      ],
      "original": "날 보는 네 눈에 열린",
      "romanization": "nal boneun ne nune yeollin",
      "english": "In your eyes as you look at me",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "Another world",
      "romanization": "another world",
      "english": "Another world",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "덧날 뿐인 흉터들까지",
      "romanization": "deotnal ppunin hyangteodeulkkaji",
      "english": "Even the scars that only fester",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "You save my soul",
      "romanization": "you save my soul",
      "english": "You save my soul",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "첫 마주쳤던 Angel eyes",
      "romanization": "cheot majuchyeotdeon angel eyes",
      "english": "The angel eyes I first looked into",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "또 애틋한 Your paradise",
      "romanization": "tto aeteuthan your paradise",
      "english": "And your achingly sweet paradise",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "그 안 눈을 떠 버린",
      "romanization": "geu an nuneul tteo beorin",
      "english": "Awakened deep within it",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "갈망들이 지독해",
      "romanization": "galmangdeuri jidokhae",
      "english": "The longing is consuming me",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "네 눈빛 만으로",
      "romanization": "ne nunbit maneuro",
      "english": "With just one look from you",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "난 이미 Can’t escape",
      "romanization": "nan imi can’t escape",
      "english": "I'm already trapped, can’t escape",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "You’re supernatural",
      "romanization": "you’re supernatural",
      "english": "You’re supernatural",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "내게",
      "romanization": "naege",
      "english": "To me",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "Take me down",
      "romanization": "take me down",
      "english": "Take me down",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "더 깊이 새겨지게",
      "romanization": "deo gipi saegyeojige",
      "english": "So you'll be carved deeper into me",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "Tame me now",
      "romanization": "tame me now",
      "english": "Tame me now",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
      "original": "너로 날 물들이게",
      "romanization": "neoro nal muldeurige",
      "english": "So you can paint me in your colors",
      "adlib": false
    },
    {
      "start": 0,
      "end": 0,
      "members": [],
